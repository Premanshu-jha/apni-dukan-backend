<?xml version="1.0" encoding="UTF-8"?>
<!--
  Findings we have looked at and decided are not problems here. Each entry says why, and is kept as narrow as possible.
  SpotBugs reports Medium and High findings (threshold=Medium); any of those not listed here fails the build.
-->
<FindBugsFilter>
    <!-- Storing objects passed to a constructor is how Spring dependency injection works (a service keeps the
         repositories and clients it is given). Not a leak. -->
    <Match>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>
    <!-- Returning an internal object from a getter is fine for entities (JPA), API records (serialised to JSON) and
         configuration/properties holders. Elsewhere (services, utilities) it stays reported. -->
    <Match>
        <Bug pattern="EI_EXPOSE_REP"/>
        <Or>
            <Package name="~in\.apnidukan\..*\.domain"/>
            <Package name="~in\.apnidukan\..*\.api"/>
            <Class name="~.*(Config|Properties)"/>
        </Or>
    </Match>
    <!-- A sign-in result carries the person just read for that request; the controller only turns it into the JSON
         reply. Nothing keeps it or changes it afterwards. -->
    <Match>
        <Bug pattern="EI_EXPOSE_REP"/>
        <Class name="in.apnidukan.auth.service.AuthTokens"/>
    </Match>
    <!-- We turn off CSRF on purpose: there are no cookies or server sessions, every call carries a bearer token
         (see SecurityConfig). CSRF only matters for cookie-based sign-in. -->
    <Match>
        <Bug pattern="SPRING_CSRF_PROTECTION_DISABLED"/>
        <Class name="in.apnidukan.common.security.SecurityConfig"/>
    </Match>
    <!-- These constructors refuse to start the app when a required setting is missing or too weak (fail fast, on
         purpose): no SMS/mail settings, production misconfiguration, a JWT_SECRET too short to sign safely, or a job's batch
         size, concurrency, retention or slice below 1, or a refresh grace longer than the 60 s retry time. -->
    <Match>
        <Bug pattern="CT_CONSTRUCTOR_THROW"/>
        <Or>
            <Class name="in.apnidukan.auth.notify.Msg91SmsSender"/>
            <Class name="in.apnidukan.auth.notify.SmtpEmailSender"/>
            <Class name="in.apnidukan.config.ProductionSafetyCheck"/>
            <Class name="in.apnidukan.common.security.JwtService"/>
            <Class name="in.apnidukan.auth.notify.ResendEmailSender"/>
            <Class name="in.apnidukan.auth.service.SignInCleanupJob"/>
            <Class name="in.apnidukan.notifications.service.MessageCleanupJob"/>
            <Class name="in.apnidukan.notifications.service.NotificationSendJob"/>
            <Class name="in.apnidukan.salon.service.AutoEndJob"/>
            <Class name="in.apnidukan.files.service.FileRefService"/>
            <Class name="in.apnidukan.notifications.service.AccountWipeJob"/>
            <Class name="in.apnidukan.files.service.PhotoCleaning"/>
            <Class name="in.apnidukan.notifications.service.InboxService"/>
            <Class name="in.apnidukan.auth.service.AuthService"/>
            <Class name="in.apnidukan.notifications.service.SalonMessagePurgeJob"/>
            <Class name="in.apnidukan.salon.service.SalonClosingJob"/>
            <Class name="in.apnidukan.salon.service.SalonCalendar"/>
            <Class name="in.apnidukan.salon.service.SalonSetups"/>
        </Or>
    </Match>
    <!-- SpotBugs 4.10 / FindSecBugs 1.14 (new findings in code that didn't change):
         SecurityConfig.writeError writes the 401/403 answers of the security filters. Every call passes our own
         constant code and message (NOT_SIGNED_IN, FORBIDDEN, ...), never anything from the request, and the answer is
         application/json, so there is nothing a browser could run. -->
    <Match>
        <Bug pattern="XSS_SERVLET"/>
        <Class name="in.apnidukan.common.security.SecurityConfig"/>
        <Method name="writeError"/>
    </Match>
    <!-- A request wrapper's getInputStream must hand out the stream it wraps (here the one that counts bytes against
         the size limit): that is the whole point of the wrapper, not a leak of its internals. -->
    <Match>
        <Bug pattern="EI_EXPOSE_REP"/>
        <Class name="in.apnidukan.common.web.RequestSizeLimitFilter$LimitedRequest"/>
        <Method name="getInputStream"/>
    </Match>
    <!-- revokeAllOrWarn logs why the sign-out was asked for: every caller passes a constant of our own ("Shop membership
         ended", ...) and a UUID, never anything from a request, so no line break can get into the log. -->
    <Match>
        <Bug pattern="CRLF_INJECTION_LOGS"/>
        <Class name="in.apnidukan.common.security.SessionRevocations"/>
        <Method name="revokeAllOrWarn"/>
    </Match>
</FindBugsFilter>
