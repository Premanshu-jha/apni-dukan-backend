# Copy this file to .env (same folder as pom.xml) and fill in real values.
# .env is ignored by Git. Never commit real values.

# Neon Postgres (dev branch). Pooled URL for the app:
DB_URL=jdbc:postgresql://ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/apnidukan?sslmode=require
# Direct (non-pooled) URL for Flyway migrations: same host without "-pooler"
DB_URL_DIRECT=jdbc:postgresql://ep-xxxx.ap-southeast-1.aws.neon.tech/apnidukan?sslmode=require
DB_USER=
DB_PASSWORD=

# Cloudflare R2 (from the R2 API token: Access Key ID + Secret Access Key)
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_BUCKET=apnidukan-files
R2_ACCESS_KEY=
R2_SECRET_KEY=

# Development only: lets you call the API with X-Dev-Shop-Id / X-Dev-User-Id
# headers until real sign-in (milestone 2) exists. Must be false in production.
DEV_AUTH_ENABLED=true
